      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1qz4v4i1muzgv11esqblf1tpgvhz].[__tableau_internal_object_id__].[cnt:Dataset.csv_4F903CFB9F304D13B7C5E698AAE7149A:qk]&quot;' value='Clean Rows' />
        </aliases>
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1671039610359808]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER(TRIM([country_raw]))' />
      </column>
      <column caption='Continent' datatype='string' name='[Calculation_1671039612182529]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER(TRIM([continent_raw]))' />
      </column>
      <column caption='Income Context' datatype='string' name='[Calculation_1671039612575746]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([income_context_raw]) OR TRIM([income_context_raw]) = &quot;&quot; THEN &quot;Not recorded&quot;&#13;&#10;   ELSE PROPER(REPLACE(TRIM([income_context_raw]), &quot;-&quot;, &quot; &quot;))&#13;&#10;   END' />
      </column>
      <column caption='Priority Band' datatype='string' name='[Calculation_1671039613988867]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='PROPER(TRIM([priority_band_raw]))' />
      </column>
      <column caption='Duplicate Flag' datatype='string' name='[Calculation_1671039614648324]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([source_note], &quot;DUPLICATE&quot;) THEN &quot;Duplicate&quot; ELSE &quot;Original&quot; END' />
      </column>
      <column caption='Missing Value Flag' datatype='string' name='[Calculation_1671039635542021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL([indicator_value]) THEN &quot;Missing&quot; ELSE &quot;Has value&quot; END' />
      </column>
      <column caption='Life Expectancy' datatype='real' name='[Calculation_1671039637508102]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [indicator_code] = &quot;HEALTH_LE&quot; THEN [indicator_value] END' />
      </column>
      <column caption='Population' datatype='real' name='[Calculation_1671039638028295]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [indicator_code] = &quot;POP_TOTAL&quot; THEN [indicator_value] END' />
      </column>
      <column caption='GDP per Capita' datatype='real' name='[Calculation_1671039638192136]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [indicator_code] = &quot;ECON_GDP_PC&quot; THEN [indicator_value] END' />
      </column>
      <column caption='   High Priority Country-Years' datatype='integer' name='[Calculation_1671039638978569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Calculation_1671039613988867] = &quot;High Priority&quot; THEN [Calculation_1671039610359808] + &quot;-&quot; + STR([year_raw]) END)' />
      </column>
      <column caption='Countries Analysed' datatype='integer' name='[Calculation_1671039641628682]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Calculation_1671039610359808])' />
      </column>
      <column caption='Missing Values' datatype='integer' name='[Calculation_1671039680798731]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF ISNULL([indicator_value]) THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Years Covered' datatype='integer' name='[Calculation_1671039680925708]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([year_raw])' />
      </column>
      <column caption='Indicators Covered' datatype='integer' name='[Calculation_1671039681007629]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([indicator_code])' />
      </column>
